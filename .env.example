# Required. Keep the real value in .env and never commit it.
LUMEN_API_KEY=your_lumen_research_token_here
# Required. Lumen blocks default/script-generic user agents.
# Include a project name/version and a monitored contact address.
LUMEN_USER_AGENT=lumen-jsonl-ingestor/3.0 (+researcher@example.edu)

# Required acknowledgement. Set true only after reviewing Lumen's API Terms of Use.
LUMEN_TERMS_ACCEPTED=true

# Lumen asks researchers planning large scraping projects to contact the team in advance.
# Set true after you have done so for a full-history or million-record project.
LUMEN_LARGE_PROJECT_CONTACTED=true

# Official API origin and routes.
LUMEN_API_BASE_URL=https://lumendatabase.org
LUMEN_SEARCH_PATH=/notices/search.json
LUMEN_TOPICS_PATH=/topics.json

# Local raw/quarantine/state paths.
LUMEN_RAW_DIR=raw
LUMEN_QUARANTINE_DIR=quarantine
LUMEN_STATE_DIR=.state
LUMEN_CHECKPOINT_FILE=checkpoint.json
LUMEN_SQLITE_FILE=ingestion_state.sqlite3

# Authenticated API guidance is approximately one request/second, with at least
# one second between automated requests. Values below 1.0 are rejected.
LUMEN_REQUEST_DELAY_SECONDS=1.10
LUMEN_REQUEST_TIMEOUT_SECONDS=60
LUMEN_MAX_RETRIES=6
LUMEN_BACKOFF_BASE_SECONDS=2
LUMEN_JITTER_MAX_SECONDS=1
LUMEN_RATE_LIMIT_LOW_WATERMARK=1

# The docs state a default of 10 records/page but do not document a safe maximum.
LUMEN_PER_PAGE=100
LUMEN_SEARCH_RESULT_CEILING=10000

# Initial date windows are recursively split whenever a search exceeds 10,000.
LUMEN_INITIAL_WINDOW_DAYS=30

# Snapshot range, Unix epoch milliseconds. End defaults to current UTC time at
# the first run and is frozen in checkpoint.json. Start=0 means full history.
LUMEN_START_MS=0
# LUMEN_END_MS=

# Optional documented filters as one JSON object. Managed keys are forbidden:
# authentication_token, page, per_page, date_submitted, sort_by.
LUMEN_EXTRA_QUERY_PARAMS_JSON={}

# Documented values: date_received asc/desc, relevancy asc/desc, or blank.
LUMEN_SORT_BY=date_received asc

# Fetch the finite topics reference endpoint once per run.
LUMEN_FETCH_TOPICS=true

LUMEN_LOG_LEVEL=INFO
LUMEN_VERIFY_SSL=true
LUMEN_FSYNC_WRITES=true
